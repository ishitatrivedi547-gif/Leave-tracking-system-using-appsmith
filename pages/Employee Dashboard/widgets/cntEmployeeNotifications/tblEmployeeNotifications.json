  "tableData": "{{\n  (() => {\n    const notifications = q_employee_get_notifications.data || [];\n    const filter = selNotificationFilter.selectedOptionValue;\n\n    if (filter === \"Unread\") {\n      return notifications.filter(item => item.is_read === false);\n    }\n\n    if (filter === \"Read\") {\n      return notifications.filter(item => item.is_read === true);\n    }\n\n    return notifications;\n  })()\n}}",
